# ---------------------------------------------------------------------------
# Robinhood Chain. Every value below already defaults to the canonical mainnet
# deployment in src/lib/chain.ts — this file only exists to override them
# (private RPC, a testnet, or a different vault).
#
# The app runs live against mainnet with NO .env file at all.
# ---------------------------------------------------------------------------

# Chain (defaults: 4663 / https://rpc.mainnet.chain.robinhood.com)
# VITE_CHAIN_ID=4663
# VITE_CHAIN_NAME="Robinhood Chain"
# VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Canonical USDG (Global Dollar), 6 decimals.
# The chain carries several look-alike "Global Dollar" ERC-20s — only override
# this with an address you have verified on the explorer.
# VITE_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Steakhouse USDG vault (ERC-4626, curated on Morpho).
# VITE_STEAKHOUSE_USDG_VAULT=0xBeEff033F34C046626B8D0A041844C5d1A5409dd
